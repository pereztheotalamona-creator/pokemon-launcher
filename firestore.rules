rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil público de cada usuario (nombre, avatar, estadísticas, últ. conexión)
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Solicitudes de amistad: solo el remitente y el destinatario pueden verla/tocarla
    match /solicitudesAmistad/{id} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.de || request.auth.uid == resource.data.para);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.de;
      allow update: if request.auth != null && request.auth.uid == resource.data.para;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.de || request.auth.uid == resource.data.para);
    }

    // Amistades confirmadas: documento con los dos participantes
    match /amistades/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantes &&
        request.resource.data.participantes.size() == 2;
      allow delete: if request.auth != null && request.auth.uid in resource.data.participantes;
    }

    // Actividad reciente (logros desbloqueados) - lectura pública para amigos, escritura solo propia
    match /actividad/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
