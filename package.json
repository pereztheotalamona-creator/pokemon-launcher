{
  "name": "pokemon-launcher",
  "version": "1.0.1",
  "description": "Launcher de fangames Pokémon con logros, biblioteca y comunidad",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publicar": "electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "Pokémon Launcher",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@hyrious/marshal": "^0.3.4",
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1",
    "megajs": "^1.3.10",
    "yauzl": "^3.4.0"
  },
  "build": {
    "appId": "com.pokemonlauncher.app",
    "productName": "Pokemon Launcher",
    "copyright": "Pokémon Launcher",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!.github/**",
      "!*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pokémon Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "PokeLauncherInstaller.exe",
      "license": "build/licencia.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pereztheotalamona-creator",
        "repo": "pokemon-launcher",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@44.1.1": true,
    "electron-winstaller": false
  }
}